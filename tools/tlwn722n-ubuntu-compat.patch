diff --git a/Makefile b/Makefile
index 2aa7eef..48909fa 100755
--- a/Makefile
+++ b/Makefile
@@ -1,4 +1,8 @@
 EXTRA_CFLAGS += $(USER_EXTRA_CFLAGS) -fno-pie
+# Ubuntu backports the per-interface monitor callback to its 6.8 kernel.
+ifneq (,$(shell sed -n '/(\*set_monitor_channel)/,+3p' $(KSRC)/include/net/cfg80211.h 2>/dev/null | grep 'struct net_device'))
+EXTRA_CFLAGS += -DRTW_CFG80211_MONITOR_HAS_NETDEV
+endif
 EXTRA_CFLAGS += -O1
 #EXTRA_CFLAGS += -O3
 EXTRA_CFLAGS += -Wno-unused-variable
